{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Protocol_Evac Player 运行时架构",
    "subtitle": "基于当前代码与 2026-8-6 归档；虚线表示尚未完成的 HitWindow 接入",
    "output": "Player运行时架构.html",
    "animation": "none",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "frame-path",
        "label": "每帧主路径",
        "focus": ["player-controller", "input-runtime", "player-context", "transition-selector", "player-hfsm", "skill-runtime", "animation-output"],
        "note": "从 PlayerController 的显式调度开始，沿输入、转换、状态、技能到动画表现读取当前运行链路。"
      },
      {
        "id": "motion-path",
        "label": "运动执行",
        "focus": ["player-context", "player-view", "player-hfsm", "animation-output", "player-motor"],
        "note": "Context 汇总视角与运动事实；HFSM 写意图，Root Motion 经 Context 交给 Motor 执行。"
      },
      {
        "id": "combat-gap",
        "label": "命中闭环缺口",
        "focus": ["skill-runtime", "combat-hitbox", "damage-contract"],
        "note": "CombatHitbox 已能独立提交 DamageData，但 PlayerSkillStepData 的 HitWindow 尚未驱动 Open / Close。"
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "origin": [48, 72],
    "cols": 6,
    "gapX": 78,
    "gapY": 92,
    "cellW": 170,
    "cellH": 76
  },
  "components": [
    {
      "id": "player-settings",
      "type": "database",
      "label": "Player Settings",
      "sublabel": "配置聚合与 Skill Step 数据",
      "tag": "ScriptableObject",
      "row": 0,
      "col": 0
    },
    {
      "id": "player-controller",
      "type": "backend",
      "label": "PlayerController",
      "sublabel": "组合根与显式帧调度",
      "tag": "运行顺序契约",
      "row": 0,
      "col": 2
    },
    {
      "id": "input-runtime",
      "type": "frontend",
      "label": "Input Runtime",
      "sublabel": "PlayerInputReader + InputBuffer",
      "tag": "读取与缓存",
      "row": 1,
      "col": 0
    },
    {
      "id": "player-context",
      "type": "database",
      "label": "PlayerContext",
      "sublabel": "共享运行事实、输入与运动意图",
      "tag": "本地运行时记忆",
      "row": 1,
      "col": 1
    },
    {
      "id": "transition-selector",
      "type": "security",
      "label": "Transition Selector",
      "sublabel": "规则注册、优先级裁决与切换提交",
      "tag": "唯一切换决策点",
      "row": 1,
      "col": 2
    },
    {
      "id": "player-hfsm",
      "type": "backend",
      "label": "Player HFSM",
      "sublabel": "活动路径、LCA 与生命周期",
      "tag": "宏观行为状态",
      "row": 1,
      "col": 3
    },
    {
      "id": "skill-runtime",
      "type": "backend",
      "label": "Skill Runtime",
      "sublabel": "技能门面与段落时间轴",
      "tag": "段落与推进窗口",
      "row": 1,
      "col": 4
    },
    {
      "id": "combat-hitbox",
      "type": "backend",
      "label": "CombatHitbox",
      "sublabel": "范围检测、窗口去重与伤害提交",
      "tag": "Player 尚未接入",
      "row": 1,
      "col": 5
    },
    {
      "id": "player-view",
      "type": "frontend",
      "label": "Player View",
      "sublabel": "视角模式与相机姿态",
      "tag": "表现控制",
      "row": 2,
      "col": 1
    },
    {
      "id": "player-motor",
      "type": "backend",
      "label": "PlayerMotor",
      "sublabel": "物理移动与接地刷新",
      "tag": "FixedUpdate 执行",
      "row": 2,
      "col": 3
    },
    {
      "id": "animation-output",
      "type": "frontend",
      "label": "Animation Output",
      "sublabel": "AnimWriter + RootMotionReceiver",
      "tag": "Animator 表现",
      "row": 2,
      "col": 4
    },
    {
      "id": "damage-contract",
      "type": "external",
      "label": "IDamageable",
      "sublabel": "DamageData 接收方与测试木桩",
      "tag": "Combat 契约",
      "row": 2,
      "col": 5
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "单个 Player 实例的本地运行时",
      "wraps": ["player-controller", "input-runtime", "player-context", "transition-selector", "player-hfsm", "skill-runtime", "player-view", "player-motor", "animation-output"],
      "pad": 28
    }
  ],
  "connections": [
    { "id": "settings-to-controller", "from": "player-settings", "to": "player-controller" },
    { "id": "controller-to-input", "from": "player-controller", "to": "input-runtime", "label": "Update #1", "variant": "emphasis" },
    { "id": "input-to-context", "from": "input-runtime", "to": "player-context", "variant": "emphasis" },
    { "id": "context-to-transition", "from": "player-context", "to": "transition-selector", "label": "读取运行事实", "variant": "emphasis" },
    { "id": "transition-to-hfsm", "from": "transition-selector", "to": "player-hfsm", "label": "ChangeState", "variant": "emphasis" },
    { "id": "hfsm-to-skill", "from": "player-hfsm", "to": "skill-runtime", "label": "Open / Request / Close", "variant": "emphasis" },
    { "id": "skill-to-animation", "from": "skill-runtime", "to": "animation-output" },
    { "id": "context-to-view", "from": "player-context", "to": "player-view" },
    { "id": "hfsm-to-motor", "from": "player-hfsm", "to": "player-motor" },
    { "id": "animation-to-motor", "from": "animation-output", "to": "player-motor", "label": "Root Motion Δ" },
    { "id": "skill-to-hitbox", "from": "skill-runtime", "to": "combat-hitbox", "label": "HitWindow 待接入", "variant": "dashed" },
    { "id": "hitbox-to-damageable", "from": "combat-hitbox", "to": "damage-contract" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "当前 Update 契约",
      "items": [
        "InputReader → ViewController → TransitionSelector",
        "PlayerStateMachine → PlayerSkillController → PlayerAnimWriter",
        "FixedUpdate：HFSM FixedTick → PlayerMotor FixedTick"
      ]
    },
    {
      "dot": "emerald",
      "title": "职责边界",
      "items": [
        "Controller 只装配与调度；Context 保存共享事实",
        "Transition 决策，HFSM 执行状态，Skill 推进段落",
        "State 写运动意图，Motor 执行，Animator 更新表现"
      ]
    },
    {
      "dot": "amber",
      "title": "下一处真实缺口",
      "items": [
        "PlayerSkillStepData 已定义 HitWindow 与 Damage",
        "当前三段配置均未启用 HitWindow，Damage 仍为 0",
        "下一步仅打通一段普攻、一个目标、一个窗口、一次伤害"
      ]
    }
  ]
}
