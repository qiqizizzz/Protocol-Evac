<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
        <ui:VisualElement name="ability-composer-root" class="ac-root">
        <ui:VisualElement name="top-context-bar" class="ac-context-bar">
            <ui:VisualElement class="ac-context-inputs">
                <uie:ObjectField name="preview-source-field" label="" class="ac-object-field" />
                <uie:ObjectField name="animation-clip-field" label="" class="ac-object-field" />
            </ui:VisualElement>
            <ui:VisualElement class="ac-context-spacer" />
            <ui:VisualElement class="ac-context-actions">
                <ui:Button name="create-preview-button" class="ac-button ac-button-secondary">
                    <ui:Label text="创建预览" class="ac-button-label" />
                </ui:Button>
                <ui:Button name="focus-preview-button" class="ac-button ac-button-secondary">
                    <ui:Label text="聚焦 Scene" class="ac-button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="content-layout" class="ac-content-layout">
            <ui:VisualElement name="preview-control-panel" class="ac-panel ac-preview-panel">
                <ui:VisualElement class="ac-preview-header">
                    <ui:Label text="PREVIEW" class="ac-section-title" />
                    <ui:Label text="-- / --" class="ac-frame-counter" />
                </ui:VisualElement>
                <ui:VisualElement class="ac-transport-row">
                    <ui:Button class="ac-transport-button"><ui:Label text="|&lt;" class="ac-button-label" /></ui:Button>
                    <ui:Button class="ac-transport-button"><ui:Label text="&lt;" class="ac-button-label" /></ui:Button>
                    <ui:Button class="ac-transport-button ac-play-button"><ui:Label text="▶" class="ac-button-label" /></ui:Button>
                    <ui:Button class="ac-transport-button"><ui:Label text="&gt;" class="ac-button-label" /></ui:Button>
                    <ui:Button class="ac-transport-button"><ui:Label text="&gt;|" class="ac-button-label" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="ac-preview-stat-group">
                    <ui:Label text="FPS" class="ac-stat-label" />
                    <ui:Label text="--" class="ac-stat-value" />
                    <ui:Label text="Time" class="ac-stat-label" />
                    <ui:Label text="--:--" class="ac-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="ac-panel-spacer" />
                <ui:Button name="add-event-button" class="ac-button ac-button-primary">
                    <ui:Label text="＋ 添加事件" class="ac-button-label ac-muted-button-label" />
                </ui:Button>
                <ui:Button name="delete-event-button" class="ac-button ac-button-danger">
                    <ui:Label text="删除选中事件" class="ac-button-label ac-muted-button-label" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="timeline-panel" class="ac-panel ac-timeline-panel">
                <ui:VisualElement class="ac-timeline-header">
                    <ui:Label text="TIMELINE" class="ac-section-title" />
                </ui:VisualElement>
                <ui:VisualElement name="timeline-workspace" class="ac-timeline-workspace">
                    <ui:VisualElement class="ac-timeline-ruler">
                        <ui:VisualElement class="ac-ruler-label-row">
                            <ui:Label text="0" class="ac-ruler-frame-label" />
                            <ui:Label text="5" class="ac-ruler-frame-label" />
                            <ui:Label text="10" class="ac-ruler-frame-label" />
                            <ui:Label text="15" class="ac-ruler-frame-label" />
                            <ui:Label text="20" class="ac-ruler-frame-label" />
                            <ui:Label text="25" class="ac-ruler-frame-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ac-ruler-tick-row">
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick" />
                            <ui:VisualElement class="ac-ruler-tick ac-ruler-tick-major" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="ac-timeline-empty-state">
                        <ui:Label text="选择 Animation Clip 后，在此处编辑动画事件" class="ac-empty-state-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="event-inspector-panel" class="ac-panel ac-inspector-panel">
                <ui:Label text="EVENT INSPECTOR" class="ac-section-title" />
                <ui:VisualElement name="event-inspector-workspace" class="ac-inspector-workspace" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottom-status-bar" class="ac-status-bar">
            <ui:Label text="逐帧吸附" class="ac-status-item ac-status-enabled" />
            <ui:Label text="缩放 --" class="ac-status-item" />
            <ui:Label text="当前帧 --" class="ac-status-item" />
            <ui:VisualElement class="ac-status-spacer" />
            <ui:Label text="草稿状态：尚未加载动画" class="ac-status-item" />
            <ui:Button class="ac-button ac-button-apply">
                <ui:Label text="应用到动画" class="ac-button-label ac-muted-button-label" />
            </ui:Button>
            <ui:Button class="ac-button ac-button-secondary">
                <ui:Label text="还原草稿" class="ac-button-label ac-muted-button-label" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
