.ac-root {
    flex-grow: 1;
    background-color: rgb(48, 48, 48);
    color: rgb(210, 210, 210);
    -unity-font-style: normal;
}

.ac-context-bar {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(56, 56, 56);
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 30, 30);
}

.ac-context-inputs,
.ac-context-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ac-context-spacer {
    flex-grow: 1;
}

.ac-object-field {
    width: 160px;
    min-width: 120px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 8px;
}

.ac-global-animation-toggle {
    min-width: 108px;
    margin-left: 2px;
    margin-right: 4px;
    color: rgb(200, 200, 200);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-global-animation-toggle .unity-base-field__label {
    width: auto;
    min-width: 0;
    margin-right: 6px;
}

.ac-content-layout {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.ac-panel {
    min-height: 0;
    background-color: rgb(56, 56, 56);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(30, 30, 30);
    border-right-color: rgb(30, 30, 30);
    border-bottom-color: rgb(30, 30, 30);
    border-left-color: rgb(30, 30, 30);
}

.ac-preview-panel {
    width: 220px;
    min-width: 220px;
    margin-right: 8px;
    padding-top: 0;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.ac-timeline-panel {
    flex-grow: 1;
    min-width: 420px;
    min-height: 0;
    margin-right: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgb(56, 56, 56);
    border-width: 0;
}

.ac-inspector-panel {
    width: 360px;
    min-width: 360px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.ac-preview-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 42px;
}

.ac-frame-counter {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 8px;
    color: rgb(210, 210, 210);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-frame-input {
    width: 30px;
    min-width: 30px;
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 3px;
    padding-right: 3px;
    color: rgb(210, 210, 210);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-frame-separator,
.ac-frame-total {
    color: rgb(210, 210, 210);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-frame-separator {
    margin-left: 0;
    margin-right: 0;
}

.ac-button {
    min-height: 28px;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    -unity-font-style: normal;
}

.ac-button-label {
    color: rgb(200, 200, 200);
    font-size: 11px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.ac-transport-button .ac-button-label {
    font-size: 12px;
    -unity-font-style: normal;
}

.ac-button-secondary {
}

.ac-bottom-save-button,
.ac-bottom-undo-button {
    min-width: 66px;
    min-height: 26px;
    margin-left: 4px;
    margin-right: 0;
}

.ac-transport-row {
    flex-direction: row;
    height: 28px;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
}

.ac-transport-button {
    width: 20px;
    min-width: 20px;
    height: 20px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
}

.ac-transport-row .ac-transport-button {
    margin-left: 0;
    margin-right: 0;
}

.ac-transport-button > .ac-button-label {
    align-self: center;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.ac-panel-spacer {
    flex-grow: 1;
}

.ac-module-divider {
    height: 1px;
    flex-shrink: 0;
    margin-top: 0;
    background-color: rgb(30, 30, 30);
}

.ac-event-action-row {
    flex-direction: row;
    margin-top: 8px;
}

.ac-event-action-button {
    flex-grow: 1;
    min-width: 0;
    min-height: 24px;
    margin-left: 0;
    margin-right: 4px;
}

.ac-event-action-button-last {
    margin-right: 0;
}

.ac-hit-window-divider {
    margin-top: 10px;
}

.ac-hit-window-action-row {
    flex-direction: row;
    margin-top: 8px;
}

.ac-hit-window-action-button {
    flex-grow: 1;
    min-width: 0;
    min-height: 24px;
    margin-left: 0;
    margin-right: 4px;
}

.ac-hit-window-action-button-last {
    margin-right: 0;
}

.ac-window-track-toggle-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 22px;
    margin-top: 8px;
}

.ac-window-track-toggle-cell {
    width: 50%;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 4px;
}

.ac-window-track-toggle-cell-last {
    margin-right: 0;
}

.ac-window-track-toggle-row-secondary {
    margin-top: 2px;
}

.ac-window-track-toggle-cell-wide {
    width: 100%;
}

.ac-window-track-toggle-button {
    width: 24px;
    min-width: 24px;
    height: 20px;
    min-height: 20px;
    margin: 0;
    padding: 0;
    color: rgb(184, 184, 184);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.ac-window-track-toggle-label {
    margin-left: 5px;
    color: rgb(184, 184, 184);
    font-size: 10px;
}

.ac-timeline-workspace,
.ac-inspector-workspace {
    flex-grow: 1;
    min-height: 0;
}

.ac-inspector-tab-bar {
    flex-direction: row;
    min-height: 28px;
    margin-top: -23px;
    margin-right: -12px;
    margin-bottom: 10px;
    margin-left: -12px;
    padding-left: 0;
    align-items: flex-end;
    background-color: rgb(48, 48, 48);
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 30, 30);
}

.ac-inspector-tab-button {
    height: 26px;
    min-width: 78px;
    margin-left: 0;
    margin-right: 2px;
    padding-right: 2px;
    padding-left: 6px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    border-width: 1px;
    border-color: rgb(30, 30, 30);
    background-color: rgb(48, 48, 48);
}

.ac-inspector-tab-button-selected {
    background-color: rgb(56, 56, 56);
    border-bottom-width: 0;
}

.ac-inspector-tab-label {
    margin-right: 6px;
    color: rgb(220, 220, 220);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-inspector-tab-marker-event,
.ac-inspector-tab-marker-window {
    margin-right: 5px;
    font-size: 10px;
    -unity-font-style: normal;
}

.ac-inspector-tab-marker-event {
    color: rgb(220, 220, 220);
}

.ac-inspector-tab-marker-window {
    color: rgb(191, 88, 54);
}

.ac-inspector-tab-close-button {
    width: 16px;
    min-width: 16px;
    height: 18px;
    min-height: 18px;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    color: rgb(175, 175, 175);
    font-size: 14px;
    -unity-font-style: normal;
}

.ac-inspector-tab-content {
    flex-grow: 1;
    min-height: 0;
}

.ac-inspector-save-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.ac-inspector-save-button {
    min-width: 64px;
    min-height: 24px;
    margin-left: 0;
    margin-right: 0;
}

.ac-inspector-empty-state {
    margin-top: 14px;
    color: rgb(140, 140, 140);
    font-size: 10px;
    -unity-font-style: normal;
}

.ac-inspector-field,
.ac-inspector-readonly-value {
    margin-top: 8px;
    color: rgb(210, 210, 210);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-inspector-field > .unity-base-field__label {
    width: 125px;
    min-width: 125px;
    flex-shrink: 0;
}

.ac-inspector-readonly-value {
    min-height: 18px;
}

.ac-timeline-workspace {
    flex-direction: column;
}

.ac-timeline-scroll-view {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(56, 56, 56);
    border-width: 0;
}

.ac-timeline-content {
    position: relative;
    min-height: 360px;
    flex-shrink: 0;
    background-color: rgb(56, 56, 56);
}

.ac-timeline-ruler {
    position: absolute;
    top: 0;
    left: 0;
    height: 42px;
    background-color: rgb(56, 56, 56);
    border-bottom-width: 1px;
    border-bottom-color: rgb(87, 87, 87);
}

.ac-ruler-frame-label {
    position: absolute;
    top: 4px;
    width: 24px;
    color: rgb(152, 152, 152);
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: upper-center;
}

.ac-ruler-frame-label-first {
    -unity-text-align: upper-left;
}

.ac-ruler-tick {
    position: absolute;
    top: 32px;
    width: 1px;
    height: 9px;
    background-color: rgb(104, 104, 104);
}

.ac-ruler-tick-major {
    position: absolute;
    top: 24px;
    width: 1px;
    height: 17px;
    background-color: rgb(132, 132, 132);
}

.ac-timeline-track {
    position: absolute;
    top: 42px;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgb(56, 56, 56);
}

.ac-timeline-window-divider {
    position: absolute;
    top: 86px;
    right: 0;
    left: 0;
    height: 1px;
    background-color: rgb(30, 30, 30);
}

.ac-timeline-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgb(216, 164, 72);
}

.ac-timeline-event-marker {
    position: absolute;
    top: 50px;
    width: 10px;
    min-width: 10px;
    height: 10px;
    min-height: 10px;
    margin: 0;
    padding: 0;
    border-width: 0;
    rotate: 45deg;
}

.ac-timeline-event-marker-selected {
    outline-width: 2px;
    outline-color: rgb(245, 245, 245);
    outline-offset: -2px;
}

.ac-event-default {
    background-color: rgb(220, 220, 220);
}

.ac-event-gameplay {
    background-color: rgb(214, 137, 62);
}

.ac-event-vfx {
    background-color: rgb(61, 185, 190);
}

.ac-event-audio {
    background-color: rgb(216, 190, 67);
}

.ac-timeline-event-marker-selected.ac-event-default {
    border-color: rgb(245, 245, 245);
}

.ac-timeline-event-marker-selected.ac-event-gameplay {
    border-color: rgb(245, 245, 245);
}

.ac-timeline-event-marker-selected.ac-event-vfx {
    border-color: rgb(245, 245, 245);
}

.ac-timeline-event-marker-selected.ac-event-audio {
    border-color: rgb(245, 245, 245);
}

.ac-timeline-window-marker {
    position: absolute;
    top: 87px;
    min-width: 32px;
    height: 40px;
    min-height: 40px;
    margin: 0;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 0;
    justify-content: center;
    -unity-text-align: middle-left;
}

.ac-timeline-window-marker[style*="height: 4px"] {
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
}

.ac-timeline-window-track-background {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0.18;
}

.ac-window-hit-track {
    background-color: rgb(191, 88, 54);
}

.ac-window-step-advance-track {
    background-color: rgb(76, 151, 105);
}

.ac-window-movement-lock-track {
    background-color: rgb(82, 116, 190);
}

.ac-window-vfx-track {
    background-color: rgb(177, 116, 220);
}

.ac-timeline-window-marker-selected {
    border-width: 2px;
    border-color: rgb(245, 245, 245);
}

.ac-timeline-window-label {
    color: rgb(235, 235, 235);
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.ac-window-hit {
    background-color: rgb(191, 88, 54);
}

.ac-window-invincible {
    background-color: rgb(61, 145, 189);
}

.ac-window-step-advance {
    background-color: rgb(76, 151, 105);
}

.ac-window-movement-lock {
    background-color: rgb(82, 116, 190);
}

.ac-window-vfx {
    background-color: rgb(177, 116, 220);
}

.ac-timeline-empty-state {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
}

.ac-empty-state-label {
    color: rgb(118, 118, 118);
    font-size: 10px;
    -unity-font-style: normal;
}

.ac-muted-button-label {
    color: rgb(184, 184, 184);
    font-size: 10px;
    -unity-font-style: normal;
}

.ac-status-bar {
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    padding-right: 10px;
    padding-left: 12px;
    background-color: rgb(56, 56, 56);
    border-top-width: 1px;
    border-top-color: rgb(30, 30, 30);
}

.ac-status-item {
    margin-right: 14px;
    color: rgb(180, 180, 180);
    font-size: 11px;
    -unity-font-style: normal;
}

.ac-status-enabled {
    color: rgb(180, 180, 180);
}

.ac-status-spacer {
    flex-grow: 1;
}

/* 响应式布局：保持时间轴帧比例，优先压缩左右工具栏 */
.ac-layout-normal .ac-preview-panel {
    width: 220px;
    min-width: 220px;
}

.ac-layout-normal .ac-inspector-panel {
    width: 360px;
    min-width: 360px;
}

.ac-layout-normal .ac-timeline-panel {
    min-width: 420px;
}

.ac-layout-compact .ac-content-layout {
    padding-left: 6px;
    padding-right: 6px;
}

.ac-layout-compact .ac-preview-panel {
    width: 190px;
    min-width: 190px;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.ac-layout-compact .ac-inspector-panel {
    width: 300px;
    min-width: 300px;
    padding-left: 10px;
    padding-right: 10px;
}

.ac-layout-compact .ac-timeline-panel {
    min-width: 360px;
    margin-right: 6px;
}

.ac-layout-compact .ac-object-field {
    width: 140px;
    min-width: 100px;
}

.ac-layout-compact .ac-inspector-field > .unity-base-field__label {
    width: 100px;
    min-width: 100px;
}

.ac-layout-narrow .ac-context-bar {
    padding-left: 8px;
    padding-right: 8px;
}

.ac-layout-narrow .ac-content-layout {
    padding-left: 4px;
    padding-right: 4px;
}

.ac-layout-narrow .ac-preview-panel {
    width: 164px;
    min-width: 164px;
    margin-right: 4px;
    padding-left: 6px;
    padding-right: 6px;
}

.ac-layout-narrow .ac-inspector-panel {
    width: 260px;
    min-width: 260px;
    padding-left: 8px;
    padding-right: 8px;
}

.ac-layout-narrow .ac-timeline-panel {
    min-width: 300px;
    margin-right: 4px;
}

.ac-layout-narrow .ac-object-field {
    width: 120px;
    min-width: 88px;
    margin-right: 4px;
}

.ac-layout-narrow .ac-global-animation-toggle {
    min-width: 96px;
    margin-left: 0;
    margin-right: 2px;
    font-size: 10px;
}

.ac-layout-narrow .ac-context-actions .ac-button-label {
    font-size: 10px;
}

.ac-layout-narrow .ac-inspector-field > .unity-base-field__label {
    width: 82px;
    min-width: 82px;
}

.ac-layout-narrow .ac-inspector-tab-button {
    min-width: 68px;
    padding-left: 4px;
}

.ac-layout-narrow .ac-event-action-button,
.ac-layout-narrow .ac-hit-window-action-button {
    min-height: 22px;
}

.ac-layout-narrow .ac-event-action-button .ac-button-label,
.ac-layout-narrow .ac-hit-window-action-button .ac-button-label {
    font-size: 9px;
}
