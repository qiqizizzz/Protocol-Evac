# ==========================================
# External Environment Assets - 外部场景资源
# ==========================================
# Animation 与 Art 为本地美术资源，不纳入仓库
/Assets/Animation/
/Assets/Animation.meta
/Assets/Art/
/Assets/Art.meta

# 本仓库仅保留自有代码与架构，以下可恢复资源保持本地使用
/Assets/Fonts/
/Assets/Fonts.meta
/Assets/Plugins/
/Assets/Plugins.meta
/Assets/Settings/
/Assets/Settings.meta
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta
/Assets/TutorialInfo/
/Assets/TutorialInfo.meta

# Tokyo Street 为第三方大型环境资源，当前项目本地使用但不纳入仓库
/Assets/Tokyo_Street/
/Assets/Tokyo_Street.meta

# Matthew Guz VFX 为第三方特效资源，当前项目本地使用但不纳入仓库
/Assets/Matthew Guz/
/Assets/Matthew Guz.meta

# Restricted MMD-derived enemy asset, local-only by its license
/Assets/Art/Models/Enemy-流浪者/
/Assets/Art/Textures/Enemy-流浪者/
/Assets/Prefabs/Character/Enemy_流浪者.prefab

